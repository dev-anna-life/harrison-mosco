# =========================================================
# EPONIX DIGITAL PLATFORM ENVIRONMENT CONFIGURATION
# =========================================================
# Copy this file to .env or .env.local and fill in your values.

# 1. Application URL (e.g., https://eponixdigital.com or http://localhost:3000)
NEXT_PUBLIC_APP_URL=https://eponixdigital.com

# 2. Administrative & Notification Routing
ADMIN_EMAIL=eponixlimited@gmail.com
SUPPORT_EMAIL=hello@eponixdigital.com
NEXT_PUBLIC_WHATSAPP_NUMBER=2348088194093

# 3. Paystack Payment Gateway Keys (Live or Test)
# Get keys from: https://dashboard.paystack.com/#/settings/developer
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_your_public_key_here
PAYSTACK_SECRET_KEY=sk_live_your_secret_key_here

# 4. Email Dispatch Configuration (Optional: Resend or SMTP)
# Option A: Resend API Key (https://resend.com)
RESEND_API_KEY=

# Option B: Custom SMTP (e.g. Google Workspace, cPanel Webmail, Zoho, SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=eponixlimited@gmail.com
SMTP_PASS=your_app_password_here

# 5. Database URL (Prisma SQLite by default, or PostgreSQL / MySQL)
DATABASE_URL="file:./dev.db"
